# Template only: copy to .env and replace every your-* value with a real credential.
# Required for authenticated API requests and attendance: Supabase URL, publishable/anon key, service-role key.
# R2 values are only needed when using file-storage features.
PORT=3000
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=https://mcowsiazjuxrvyyybdiy.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: provide TURN credentials for video calls on restricted networks.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: fetch short-lived TURN credentials from Metered on each call.
METERED_APP_NAME=
METERED_API_KEY=
# Generate a VAPID key pair with `npx web-push generate-vapid-keys` to enable call push alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_WEBHOOK_SECRET=
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=flexbar-files
